<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EditReady" Width="940" Height="700" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#121316" Foreground="#EDEEF0">

  <Window.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="Bg" Color="#121316"/>
    <SolidColorBrush x:Key="FooterBg" Color="#17181C"/>
    <SolidColorBrush x:Key="Surface" Color="#1C1E23"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#262930"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#2E313A"/>
    <SolidColorBrush x:Key="Line" Color="#2A2D35"/>
    <SolidColorBrush x:Key="LineStrong" Color="#3A3E48"/>
    <SolidColorBrush x:Key="Text1" Color="#EDEEF0"/>
    <SolidColorBrush x:Key="Text2" Color="#A8AEB9"/>
    <SolidColorBrush x:Key="Text3" Color="#868C98"/>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8D72FF"/>
    <SolidColorBrush x:Key="AccentPress" Color="#6A4AF0"/>
    <SolidColorBrush x:Key="AccentText" Color="#BCAEFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#231E40"/>
    <SolidColorBrush x:Key="AccentLine" Color="#3B3175"/>
    <SolidColorBrush x:Key="Success" Color="#3DD68C"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#163527"/>
    <SolidColorBrush x:Key="Danger" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1D21"/>
    <SolidColorBrush x:Key="Warn" Color="#F5B544"/>

    <!-- Keyboard focus ring -->
    <Style x:Key="Focus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="#BCAEFF" StrokeThickness="1.5"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentPress}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#2C2A3D"/>
                <Setter Property="Foreground" Value="#8B88A0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text1}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#23262D"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHi}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHi}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented pills -->
    <Style x:Key="Segment" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="13,6">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text1}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33364A"/>
                <Setter Property="Foreground" Value="{StaticResource Text1}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text3}"/>
      <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>

    <!-- Thin progress bar -->
    <Style x:Key="Thin" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#2C2F39" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim dark scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#3A3E48" CornerRadius="3" Margin="3,2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#2A2D35"/>
      <Setter Property="Foreground" Value="#EDEEF0"/>
      <Setter Property="BorderBrush" Value="#3A3E48"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="320"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One card per video -->
    <DataTemplate x:Key="JobTemplate">
      <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Padding="14,12,10,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Width="40" Height="40" VerticalAlignment="Center">
            <Ellipse x:Name="badge" Fill="{StaticResource SurfaceHi}"/>
            <Path x:Name="iconWait" Data="M8,15 A7,7 0 1 1 8.01,15 M8,4.5 L8,8 L10.5,9.5" Stroke="{StaticResource Text3}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
            <TextBlock x:Name="pct" Text="{Binding PercentText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Path x:Name="iconDone" Data="M1,6 L5,10 L13,1" Stroke="{StaticResource Success}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
            <Path x:Name="iconFail" Data="M5,1 L5,9 M5,13 L5,13.2" Stroke="{StaticResource Danger}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="4" Height="15" Stretch="Uniform" Visibility="Collapsed"/>
          </Grid>

          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text1}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="Resolution · frame rate · length · video bitrate · file size. Bitrate is how much data each second of video uses: higher means more detail and bigger files."/>
            <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="bar" Style="{StaticResource Thin}" Value="{Binding Progress}" Margin="0,8,0,2" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="btnShow" Tag="show" Content="Show in folder" Style="{StaticResource Secondary}" Visibility="Collapsed"/>
            <Button x:Name="btnDetails" Tag="details" Content="Details" Style="{StaticResource TextBtn}" Visibility="Collapsed"/>
            <Button x:Name="btnRetry" Tag="retry" Content="Retry" Style="{StaticResource Secondary}" Margin="4,0,0,0" Visibility="Collapsed"/>
            <Button x:Name="btnRemove" Tag="remove" Style="{StaticResource IconBtn}" Margin="6,0,0,0" ToolTip="Remove from the list (the file stays on disk)" AutomationProperties.Name="Remove from list">
              <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource Text2}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
          <Setter TargetName="badge" Property="Fill" Value="{StaticResource AccentSoft}"/>
          <Setter TargetName="iconWait" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="pct" Property="Visibility" Value="Visible"/>
          <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
          <Setter TargetName="btnRemove" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="status" Property="Foreground" Value="{StaticResource Text1}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="badge" Property="Fill" Value="{StaticResource SuccessSoft}"/>
          <Setter TargetName="iconWait" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="iconDone" Property="Visibility" Value="Visible"/>
          <Setter TargetName="btnShow" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="badge" Property="Fill" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="iconWait" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="iconFail" Property="Visibility" Value="Visible"/>
          <Setter TargetName="status" Property="Foreground" Value="{StaticResource Danger}"/>
          <Setter TargetName="btnDetails" Property="Visibility" Value="Visible"/>
          <Setter TargetName="btnRetry" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <!-- Not a video at all: nothing to retry, just remove it -->
        <DataTrigger Binding="{Binding State}" Value="Invalid">
          <Setter TargetName="badge" Property="Fill" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="iconWait" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="iconFail" Property="Visibility" Value="Visible"/>
          <Setter TargetName="status" Property="Foreground" Value="{StaticResource Danger}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="28,22,28,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40" CornerRadius="11">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#9B82FF" Offset="0"/>
              <GradientStop Color="#5B3DF5" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Canvas Width="40" Height="40">
            <Path Data="M7.5,16 L12,16 M5.5,20 L12,20 M7.5,24 L12,24" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
            <Path Data="M16,12 L29,20 L16,28 Z" Fill="White" StrokeLineJoin="Round" Stroke="White" StrokeThickness="1.5"/>
          </Canvas>
        </Border>
        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="EditReady" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Makes your recordings quick to cut and export in Premiere" FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border x:Name="EngineBadge" Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,6">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="{StaticResource Text3}" VerticalAlignment="Center"/>
          <TextBlock x:Name="EngineText" Text="Getting ready…" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Text2}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="28,4,28,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Empty state -->
      <Grid x:Name="EmptyState" Grid.RowSpan="3">
        <Rectangle x:Name="DropRect" RadiusX="16" RadiusY="16" Stroke="#3A3E48" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#16171B"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
          <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
            <Path Data="M12,3 L12,14 M7.5,9.5 L12,14 L16.5,9.5 M4,14 L4,18.5 C4,19.3 4.7,20 5.5,20 L18.5,20 C19.3,20 20,19.3 20,18.5 L20,14" Stroke="{StaticResource AccentText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="28" Height="28" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Drop your recordings here" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
          <TextBlock Text="Videos or a whole folder. Your original files are never changed." Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="BrowseBtn" Content="Choose videos…" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,22,0,0" ToolTip="Ctrl+O"/>
          <TextBlock Text="MP4 · MKV · MOV · AVI · WEBM and more" Foreground="{StaticResource Text3}" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
      </Grid>

      <!-- List -->
      <Grid x:Name="ListHeader" Margin="2,0,0,10" Visibility="Collapsed">
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ClearBtn" Content="Clear finished" Style="{StaticResource TextBtn}" ToolTip="Remove finished videos from the list. Files stay on disk."/>
          <Button x:Name="AddBtn" Content="+  Add videos" Style="{StaticResource TextBtn}" Margin="4,0,0,0" ToolTip="Ctrl+O. You can also drag files or folders anywhere onto this window."/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
        <ItemsControl x:Name="JobList" ItemTemplate="{StaticResource JobTemplate}" Focusable="False" Margin="0,0,4,0"/>
      </ScrollViewer>

      <!-- Premiere tip -->
      <Border x:Name="Tip" Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="12" Padding="16,12,8,12" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Next step in Premiere" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#D6CEFF" FontSize="12.5" Margin="0,4,0,0">Right-click the clip in the Project panel → <Bold>Replace Footage…</Bold> → pick the <Bold>_edit.mp4</Bold>. Your edit stays exactly the same; it just exports much faster.</TextBlock>
            <TextBlock x:Name="TipScale" TextWrapping="Wrap" Foreground="#F5D08A" FontSize="12.5" Margin="0,6,0,0" Visibility="Collapsed"><Bold>Shrunk to 1080p?</Bold> If the clip looks smaller after Replace Footage, select it in the timeline, right-click → <Bold>Set to Frame Size</Bold> (or set Scale to 100 in Effect Controls).</TextBlock>
          </StackPanel>
          <Button x:Name="TipClose" Grid.Column="1" Style="{StaticResource IconBtn}" VerticalAlignment="Top" ToolTip="Don't show this again" AutomationProperties.Name="Hide tip">
            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#D6CEFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
          </Button>
        </Grid>
      </Border>

      <!-- Shown while dragging files over a non-empty list -->
      <Border x:Name="DragOverlay" Grid.RowSpan="3" CornerRadius="16" BorderBrush="{StaticResource Accent}" BorderThickness="2" Background="#E61B1734" IsHitTestVisible="False" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Path Data="M12,3 L12,14 M7.5,9.5 L12,14 L16.5,9.5 M4,14 L4,18.5 C4,19.3 4.7,20 5.5,20 L18.5,20 C19.3,20 20,19.3 20,18.5 L20,14" Stroke="{StaticResource AccentText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="34" Height="34" Stretch="Uniform"/>
          <TextBlock Text="Drop to add" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{StaticResource FooterBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="28,16,28,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="SettingsPanel">
          <StackPanel Margin="0,0,36,0">
            <TextBlock Text="SAVE COPIES TO" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Segment}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SaveNext" Content="Next to the originals" GroupName="save" Style="{StaticResource Pill}" IsChecked="True" ToolTip="Each copy goes in the same folder as its video."/>
                <RadioButton x:Name="SaveFolder" Content="Another folder…" GroupName="save" Style="{StaticResource Pill}" ToolTip="Put all copies in one folder, e.g. on a drive with more free space."/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="FolderRow" Orientation="Horizontal" Margin="2,6,0,0" Visibility="Collapsed">
              <TextBlock x:Name="FolderText" Foreground="{StaticResource Text2}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/>
              <Button x:Name="FolderChange" Content="Change" Style="{StaticResource TextBtn}" Padding="8,2" Margin="4,0,0,0" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="OPTIMIZE FOR" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Segment}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="GopFast" Content="Snappiest editing" GroupName="gop" Style="{StaticResource Pill}" ToolTip="A full frame every 5 frames: instant jumps and scrubbing. Biggest files (up to 3× the original's bitrate)."/>
                <RadioButton x:Name="GopBal" Content="Balanced" GroupName="gop" Style="{StaticResource Pill}" IsChecked="True" ToolTip="A full frame every 10 frames, up to 2× the original's bitrate. Recommended: fast cutting and exporting at a sensible file size."/>
                <RadioButton x:Name="GopSmall" Content="Smaller files" GroupName="gop" Style="{StaticResource Pill}" ToolTip="A full frame every 30 frames, up to 1.4× the original's bitrate. Smallest files, still far quicker to edit than a raw OBS recording."/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Margin="36,0,0,0">
            <TextBlock Text="RESOLUTION" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Segment}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ResOrig" Content="Original" GroupName="res" Style="{StaticResource Pill}" IsChecked="True" ToolTip="Keep each video's resolution."/>
                <RadioButton x:Name="Res1080" Content="1080p" GroupName="res" Style="{StaticResource Pill}" ToolTip="Shrink 4K and 1440p videos to 1080p: about twice as fast to convert, smaller files, smoother editing. Videos that are already 1080p or smaller are left as they are. Best when you export in 1080p."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="2,0,20,0">
            <TextBlock x:Name="StatusText" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="WarnText" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
          <Button x:Name="GoBtn" Grid.Column="1" Style="{StaticResource Primary}" MinWidth="180" Padding="24,11" FontSize="14" Content="Convert"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
